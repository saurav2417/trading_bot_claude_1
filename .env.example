# DhanHQ API credentials (https://dhanhq.co -> My Profile -> DhanHQ Trading APIs)
# Access tokens are valid for ~30 days; regenerate and update before expiry.
DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token

# Optional: Telegram notifications (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Override trading mode without editing settings.yaml: recommend | paper | live
# TRADEBOT_MODE=paper
